{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "meson compile -C builddir && meson install -C builddir && builddir/install/bin/longlens",
            "options": {
                "env": {
                    "GSETTINGS_SCHEMA_DIR": "${workspaceFolder}/builddir/install/share/glib-2.0/schemas",
                    "RUST_BACKTRACE": "1",
                    "RUST_LOG": "longlens=debug,ironrdp=debug"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}