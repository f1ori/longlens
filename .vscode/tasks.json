{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "meson compile -C builddir && meson test -C builddir && meson install -C builddir && builddir/install/bin/longlens",
            "options": {
                "env": {
                    "GSETTINGS_SCHEMA_DIR": "${workspaceFolder}/builddir/install/share/glib-2.0/schemas",
                    "XDG_DATA_DIRS": "${workspaceFolder}/builddir/install/share:/usr/local/share:/usr/share",
                    "RUST_BACKTRACE": "1",
                    "RUST_LOG": "longlens=debug,ironrdp=debug"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Setup builddir",
            "type": "shell",
            "command": "meson setup builddir --reconfigure --prefix=${workspaceFolder}/builddir/install/ -Dprofile=development",
            "problemMatcher": []
        },
        {
            "label": "Generate translation template (pot file)",
            "type": "shell",
            "command": "meson compile -C builddir longlens-pot",
            "problemMatcher": []
        }
    ]
}