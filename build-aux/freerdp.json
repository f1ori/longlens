{
    "name": "freerdp",
    "buildsystem": "cmake-ninja",
    "builddir": true,
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_INSTALL_LIBDIR=lib",
        "-DBUILD_TESTING=OFF",
        "-DBUILD_TESTING_INTERNAL=OFF",
        "-DWITH_MANPAGES=OFF",
        "-DWITH_SAMPLE=OFF",
        "-DWITH_CLIENT_COMMON=ON",
        "-DWITH_CLIENT=OFF",
        "-DWITH_CLIENT_INTERFACE=OFF",
        "-DWITH_SERVER=OFF",
        "-DWITH_SERVER_INTERFACE=OFF",
        "-DWITH_CHANNELS=ON",
        "-DWITH_CLIENT_CHANNELS=ON",
        "-DCHANNEL_DRDYNVC=ON",
        "-DCHANNEL_DRDYNVC_CLIENT=ON",
        "-DCHANNEL_DISP=ON",
        "-DCHANNEL_DISP_CLIENT=ON",
        "-DCHANNEL_CLIPRDR=OFF",
        "-DCHANNEL_RDPSND=OFF",
        "-DCHANNEL_AUDIN=OFF",
        "-DCHANNEL_RDPDR=OFF",
        "-DCHANNEL_URBDRC=OFF",
        "-DCHANNEL_SMARTCARD=OFF",
        "-DWITH_FUSE=OFF",
        "-DWITH_X11=OFF",
        "-DWITH_WAYLAND=OFF",
        "-DWITH_KRB5=OFF",
        "-DWITH_PCSC=OFF",
        "-DWITH_SMARTCARD_EMULATE=OFF",
        "-DWITH_CUPS=OFF",
        "-DWITH_ALSA=OFF",
        "-DWITH_PULSE=OFF",
        "-DWITH_OSS=OFF",
        "-DWITH_FFMPEG=OFF",
        "-DWITH_DSP_FFMPEG=OFF",
        "-DWITH_VIDEO_FFMPEG=OFF",
        "-DWITH_OPENH264=OFF",
        "-DWITH_GSM=OFF",
        "-DWITH_LAME=OFF",
        "-DWITH_FAAD2=OFF",
        "-DWITH_FAAC=OFF",
        "-DWITH_SOXR=OFF",
        "-DWITH_AOM=OFF",
        "-DWITH_YUV=OFF",
        "-DWITH_OPENCL=OFF",
        "-DWITHOUT_FREERDP_3x_DEPRECATED=ON",
        "-DWITHOUT_WINPR_3x_DEPRECATED=ON"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "*.a",
        "*.la"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/FreeRDP/FreeRDP.git",
            "commit": "6099a8d64624458ebce20e185a6d02a3ea791842"
        }
    ]
}
