[Desktop Entry]
Name=@APP_NAME@
Exec=longlens %U
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=Utility;
Keywords=RDP;Remote;Desktop;Client;GTK;Windows;Server;Connection
MimeType=application/x-rdp;
StartupNotify=true
DBusActivatable=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=longlens
