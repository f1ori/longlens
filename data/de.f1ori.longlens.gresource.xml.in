<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="/de/f1ori/longlens">
    <file compressed="true" preprocess="xml-stripblanks">ui/connection_options_dialog.ui</file>
    <file compressed="true" preprocess="xml-stripblanks">ui/destination_dialog.ui</file>
    <file compressed="true" preprocess="xml-stripblanks">ui/destination_row.ui</file>
    <file compressed="true" preprocess="xml-stripblanks">ui/destinations_page.ui</file>
    <file compressed="true" preprocess="xml-stripblanks">ui/fullscreen_bar.ui</file>
    <file compressed="true" preprocess="xml-stripblanks">ui/password_dialog.ui</file>
    <file compressed="true">ui/style.css</file>
    <file compressed="true" preprocess="xml-stripblanks">ui/theme_selector.ui</file>
    <file compressed="true" preprocess="xml-stripblanks">ui/window.ui</file>
    <file>@APP_ID@.metainfo.xml</file>
    <file>icons/hicolor/scalable/apps/@APP_ID@.svg</file>
    <file alias="icons/hicolor/symbolic/apps/@APP_ID@-symbolic.svg">icons/hicolor/symbolic/apps/de.f1ori.longlens-symbolic.svg</file>
  </gresource>
</gresources>
