<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>@APP_NAME@</name>
  <summary>Access remote desktops over RDP</summary>
  <description>
    <p>Long Lens is a simple, minimal, and modern RDP client.</p>
    <p>Features:</p>
    <ul>
      <li>Clean, minimal UI for managing a list of favorite connections</li>
      <li>Minimal UI for remote sessions</li>
      <li>One window per active session</li>
      <li>Passwords stored in the system keyring</li>
      <li>Clipboard synchronization between host and remote</li>
      <li>GNOME Search Provider for destinations (can be enabled in GNOME Settings)</li>
      <li>High-DPI display support</li>
      <li>Fullscreen mode</li>
    </ul>
  </description>

  <developer id="de.f1ori">
    <name>Florian Richter</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://github.com/f1ori/longlens</url>
  <!-- Recommended: It is highly recommended for open-source projects to display the source code repository -->
  <url type="vcs-browser">https://github.com/f1ori/longlens</url>
  <!-- Should point to the software's bug tracking system, for users to report new bugs -->
  <url type="bugtracker">https://github.com/f1ori/longlens/issues</url>
  <!-- Should link a FAQ page for this software, to answer some of the most-asked questions in detail -->
  <!-- URLs of this type should point to a webpage where users can submit or modify translations of the upstream project -->
  <url type="translate">https://github.com/f1ori/longlens</url>
  <!--<url type="faq">https://example.org/faq</url>-->
  <!-- Should provide a web link to an online user's reference, a software manual or help page -->
  <!--<url type="help">https://example.org/help</url>-->
  <!-- URLs of this type should point to a webpage showing information on how to donate to the described software project -->
  <!--<url type="donation">https://example.org/donate</url>-->
  <!-- This could for example be an HTTPS URL to an online form or a page describing how to contact the developer -->
  <!--<url type="contact">https://example.org/contact</url>-->
  <!-- URLs of this type should point to a webpage showing information on how to contribute to the described software project -->
  <url type="contribute">https://github.com/f1ori/longlens</url>

  <translation type="gettext">longlens</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <provides>
    <mediatype>application/x-rdp</mediatype>
  </provides>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://media.githubusercontent.com/media/f1ori/longlens/refs/heads/main/data/screenshots/screenshot1.png</image>
      <caption>Remote session view</caption>
    </screenshot>
    <screenshot>
      <image>https://media.githubusercontent.com/media/f1ori/longlens/refs/heads/main/data/screenshots/screenshot2.png</image>
      <caption>Destination list</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.2.0" date="2026-06-13">
      <description translate="no">
        <p>Second beta release</p>
        <ul>
          <li>Added fullscreen mode</li>
          <li>Improved password dialog</li>
          <li>Fixed touchpad scrolling</li>
          <li>Added german translation</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-06-06">
      <description translate="no">
        <p>First beta release</p>
      </description>
    </release>
  </releases>

</component>
