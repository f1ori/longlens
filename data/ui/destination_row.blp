using Gtk 4.0;
using Adw 1;

template $LlDestinationRow: Adw.ActionRow {
  activatable: true;
  selectable: false;

  [suffix]
  Button edit_button {
    icon-name: "document-edit-symbolic";
    valign: center;
    tooltip-text: _("Edit");

    styles [
      "flat",
    ]
  }

  [suffix]
  Button delete_button {
    icon-name: "edit-delete-symbolic";
    valign: center;
    tooltip-text: _("Delete");

    styles [
      "flat",
    ]
  }
}
