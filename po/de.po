#. Translators: %s is the destination name, e.g. “Office PC (10.0.0.5)”
#: src/window.rs:130
msgid "Lost the connection to “%s”. Your session will be restored."
msgstr ""
"Die Verbindung zu „%s“ wurde unterbrochen. Ihre Sitzung wird "
"wiederhergestellt."

#. Translators: %s is the destination name, e.g. “Office PC (10.0.0.5)”
#: src/window.rs:133
msgid "Lost the connection to “%s”."
msgstr "Die Verbindung zu „%s“ wurde unterbrochen."

#: src/window.rs:141
